{{!
    @template theme_lmslabs/program_fieldrow

    One profile-field condition.

    Example context (json):
    {"value": "Sales", "options": [], "is": true, "i": {} }
}}
<div class="ll-fieldrow">
    <select class="form-select custom-select" data-f="field" data-ll-tip="{{#str}}tip_pg_field, theme_lmslabs{{/str}}">
        {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
    </select>
    <select class="form-select custom-select" data-f="op" data-ll-tip="{{#str}}tip_pg_op, theme_lmslabs{{/str}}">
        <option value="is"{{#is}} selected{{/is}}>{{#str}}op_is, theme_lmslabs{{/str}}</option>
        <option value="isnot"{{#isnot}} selected{{/isnot}}>{{#str}}op_isnot, theme_lmslabs{{/str}}</option>
        <option value="contains"{{#contains}} selected{{/contains}}>{{#str}}op_contains, theme_lmslabs{{/str}}</option>
        <option value="starts"{{#starts}} selected{{/starts}}>{{#str}}op_starts, theme_lmslabs{{/str}}</option>
    </select>
    <input type="text" class="form-control" data-f="value" data-ll-tip="{{#str}}tip_pg_value, theme_lmslabs{{/str}}" value="{{value}}" placeholder="{{#str}}value, theme_lmslabs{{/str}}">
    <button type="button" class="ll-iconbtn ll-danger" data-act="fieldx" data-ll-tip="{{#str}}tip_pg_rmrule, theme_lmslabs{{/str}}" aria-label="{{#str}}remove{{/str}}">{{{i.x}}}</button>
</div>
