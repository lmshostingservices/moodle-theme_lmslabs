{{!
    @template theme_lmslabs/program_grouphead

    A heading row in the program editor.

    Example context (json):
    {"name": "Group A", "i": {} }
}}
<div class="ll-pgroup-head">
    <input type="text" class="ll-pgroup-name" value="{{name}}" data-f="name" data-ll-tip="{{#str}}tip_pg_hname, theme_lmslabs{{/str}}" placeholder="{{#str}}headingplaceholder, theme_lmslabs{{/str}}" aria-label="{{#str}}headingname, theme_lmslabs{{/str}}">
    <button type="button" class="ll-iconbtn" data-act="gup" data-ll-tip="{{#str}}tip_pg_up, theme_lmslabs{{/str}}" aria-label="{{#str}}moveup{{/str}}">{{{i.up}}}</button>
    <button type="button" class="ll-iconbtn" data-act="gdown" data-ll-tip="{{#str}}tip_pg_down, theme_lmslabs{{/str}}" aria-label="{{#str}}movedown{{/str}}">{{{i.down}}}</button>
    <button type="button" class="ll-iconbtn ll-danger" data-act="gdelete" aria-label="{{#str}}deleteheading, theme_lmslabs{{/str}}" title="{{#str}}deleteheading, theme_lmslabs{{/str}}">{{{i.x}}}</button>
</div>
