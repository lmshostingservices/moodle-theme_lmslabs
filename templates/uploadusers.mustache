    @template theme_lmslabs/uploadusers

    Upload users from a CSV file.

    Example context (json):
    {"pick": true, "i": {}, "action": "#", "sesskey": "x"}
}}
<div class="ll-uu">
    {{#pick}}
    <form method="post" action="{{action}}" enctype="multipart/form-data" class="ll-rt-drop" data-rt-drop>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="file" name="csv" accept=".csv,text/csv,text/plain" data-rt-file>
        <span class="ll-rt-dropico">{{{i.upload}}}</span>
        <strong>{{#str}}uu_drop, theme_lmslabs{{/str}}</strong>
        <span>{{#str}}uu_drop_desc, theme_lmslabs, {{maxsize}}{{/str}}</span>
        <span class="ll-rt-busy" data-rt-busy hidden><span class="ll-spin"></span>{{#str}}uu_reading, theme_lmslabs{{/str}}</span>
    </form>
    <section class="ll-fcard">
        <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.users}}}</span><div><h2>{{#str}}uu_format, theme_lmslabs{{/str}}</h2><p>{{#str}}uu_format_desc, theme_lmslabs{{/str}}</p></div>
            <a class="ll-pill ll-bk-headlink" href="{{exampleurl}}">{{{i.download}}}<span>{{#str}}uu_example, theme_lmslabs{{/str}}</span></a></header>
        <div class="ll-fcard-body">
            <div class="ll-uu-cols">
                <span class="is-need"><b>username</b>{{#str}}uu_c_username, theme_lmslabs{{/str}}</span>
                <span class="is-need"><b>firstname</b>{{#str}}uu_c_firstname, theme_lmslabs{{/str}}</span>
                <span class="is-need"><b>lastname</b>{{#str}}uu_c_lastname, theme_lmslabs{{/str}}</span>
                <span class="is-need"><b>email</b>{{#str}}uu_c_email, theme_lmslabs{{/str}}</span>
                <span><b>password</b>{{#str}}uu_c_password, theme_lmslabs{{/str}}</span>
                <span><b>course1</b>{{#str}}uu_c_course, theme_lmslabs{{/str}}</span>
                <span><b>cohort1</b>{{#str}}uu_c_cohort, theme_lmslabs{{/str}}</span>
                <span><b>profile_field_…</b>{{#str}}uu_c_profile, theme_lmslabs{{/str}}</span>
            </div>
        </div>
    </section>
    {{/pick}}

    {{#review}}
    <section class="ll-rt-summary">
        <span class="ll-rt-sumico">{{{i.upload}}}</span>
        <div class="ll-rt-summain">
            <h2>{{totalmsg}}</h2>
            <p>{{#str}}uu_checked, theme_lmslabs{{/str}}</p>
            <div class="ll-uu-colchips">
                {{#cols}}<span class="{{^known}}is-unknown{{/known}}" {{^known}}title="{{#str}}uu_unknown_tip, theme_lmslabs{{/str}}"{{/known}}>{{#known}}{{{i.check}}}{{/known}}{{name}}</span>{{/cols}}
            </div>
        </div>
        <a class="ll-iconbtn" href="{{action}}" title="{{#str}}uu_other, theme_lmslabs{{/str}}" aria-label="{{#str}}uu_other, theme_lmslabs{{/str}}">{{{i.x}}}</a>
    </section>
    {{#hasmissing}}<div class="ll-fnotice is-warn">{{{i.alert}}}<span>{{#str}}uu_missing, theme_lmslabs{{/str}} {{#missing}}<b>{{name}}</b> {{/missing}}</span></div>{{/hasmissing}}
    {{#hasunknown}}<div class="ll-fnotice is-warn">{{{i.alert}}}<span>{{#str}}uu_unknown, theme_lmslabs{{/str}}</span></div>{{/hasunknown}}
    <section class="ll-fcard">
        <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.users}}}</span><div><h2>{{#str}}uu_preview, theme_lmslabs{{/str}}</h2><p>{{#str}}uu_preview_desc, theme_lmslabs{{/str}}</p></div></header>
        <div class="ll-fcard-body ll-uu-scroll">
            <table class="ll-uu-table"><thead><tr>{{#headers}}<th>{{name}}</th>{{/headers}}</tr></thead>
                <tbody>{{#preview}}<tr>{{#cells}}<td>{{{v}}}</td>{{/cells}}</tr>{{/preview}}</tbody></table>
        </div>
    </section>
    {{#canimport}}
    <form method="post" action="{{action}}" data-rt-go>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="iid" value="{{iid}}">
        <input type="hidden" name="run" value="1">
        <section class="ll-fcard">
            <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.refresh}}}</span><div><h2>{{#str}}uu_what, theme_lmslabs{{/str}}</h2><p>{{#str}}uu_what_desc, theme_lmslabs{{/str}}</p></div></header>
            <div class="ll-fcard-body">
                <div class="ll-cp-rules ll-rt-where">
                    <label class="ll-cp-rule"><input type="radio" name="mode" value="add" checked><span class="ll-swcard-ico">{{{i.plus}}}</span><span class="ll-toggle-text"><strong>{{#str}}uu_mode_add, theme_lmslabs{{/str}}</strong><span>{{#str}}uu_mode_add_desc, theme_lmslabs{{/str}}</span></span></label>
                    <label class="ll-cp-rule"><input type="radio" name="mode" value="both"><span class="ll-swcard-ico">{{{i.refresh}}}</span><span class="ll-toggle-text"><strong>{{#str}}uu_mode_both, theme_lmslabs{{/str}}</strong><span>{{#str}}uu_mode_both_desc, theme_lmslabs{{/str}}</span></span></label>
                    <label class="ll-cp-rule"><input type="radio" name="mode" value="update"><span class="ll-swcard-ico">{{{i.users}}}</span><span class="ll-toggle-text"><strong>{{#str}}uu_mode_update, theme_lmslabs{{/str}}</strong><span>{{#str}}uu_mode_update_desc, theme_lmslabs{{/str}}</span></span></label>
                </div>
                <div class="ll-toggles ll-uu-toggles">
                    <label class="ll-toggle"><input type="checkbox" name="force" value="1" checked><span class="ll-switch-track" aria-hidden="true"></span><span class="ll-toggle-text"><strong data-ll-tip="{{#str}}tip_uu_force, theme_lmslabs{{/str}}">{{#str}}uu_force, theme_lmslabs{{/str}}</strong><span>{{#str}}uu_force_desc, theme_lmslabs{{/str}}</span></span></label>
                </div>
                {{^haspassword}}<div class="ll-fhint">{{{i.key}}}<span>{{#str}}uu_nopassword, theme_lmslabs{{/str}}</span></div>{{/haspassword}}
            </div>
        </section>
        <div class="ll-rt-bar">
            <span class="ll-rt-busy" data-rt-busy hidden><span class="ll-spin"></span>{{#str}}uu_busy, theme_lmslabs{{/str}}</span>
            <button type="submit" class="btn btn-primary ll-btn-icon" data-rt-submit>{{{i.upload}}}<span>{{#str}}uu_go, theme_lmslabs, {{total}}{{/str}}</span></button>
        </div>
    </form>
    {{/canimport}}
    {{/review}}

    {{#done}}
    <section class="ll-fcard ll-rs-done">
        <div class="ll-fcard-body">
            <span class="ll-ib-blank-ico {{#allok}}ll-greenico{{/allok}}">{{#allok}}{{{i.check}}}{{/allok}}{{^allok}}{{{i.alert}}}{{/allok}}</span>
            <h2>{{#allok}}{{#str}}uu_done_ok, theme_lmslabs{{/str}}{{/allok}}{{^allok}}{{#str}}uu_done_some, theme_lmslabs{{/str}}{{/allok}}</h2>
            <div class="ll-rp-kpis ll-uu-kpis">
                <div class="ll-rp-kpi"><strong>{{ok}}</strong><span>{{#str}}uu_k_ok, theme_lmslabs{{/str}}</span></div>
                <div class="ll-rp-kpi"><strong>{{skipped}}</strong><span>{{#str}}uu_k_skipped, theme_lmslabs{{/str}}</span></div>
                <div class="ll-rp-kpi"><strong>{{failed}}</strong><span>{{#str}}uu_k_failed, theme_lmslabs{{/str}}</span></div>
            </div>
            <ul class="ll-uu-stats">{{#stats}}<li>{{text}}</li>{{/stats}}</ul>
            <div class="ll-uu-actions">
                <a class="btn btn-primary" href="{{peopleurl}}">{{#str}}uu_viewpeople, theme_lmslabs{{/str}}</a>
                <a class="btn btn-outline-secondary" href="{{action}}">{{#str}}uu_another, theme_lmslabs{{/str}}</a>
            </div>
        </div>
    </section>
    {{#showrows}}
    <section class="ll-fcard">
        <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.alert}}}</span><div><h2>{{#str}}uu_needs, theme_lmslabs{{/str}}</h2><p>{{#str}}uu_needs_desc, theme_lmslabs{{/str}}</p></div></header>
        <div class="ll-fcard-body ll-uu-scroll">
            <table class="ll-uu-table"><thead><tr><th>{{#str}}uucsvline, tool_uploaduser{{/str}}</th><th>{{#str}}username{{/str}}</th><th>{{#str}}email{{/str}}</th><th>{{#str}}uu_what_happened, theme_lmslabs{{/str}}</th></tr></thead>
            <tbody>{{#rows}}{{^ok}}<tr class="{{#bad}}is-bad{{/bad}}"><td>{{line}}</td><td>{{username}}</td><td>{{email}}</td><td>{{note}}</td></tr>{{/ok}}{{/rows}}</tbody></table>
        </div>
    </section>
    {{/showrows}}
    {{/done}}
    <p class="ll-classic"><a href="{{classicurl}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</div>
