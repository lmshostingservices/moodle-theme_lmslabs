{{!
    @template theme_lmslabs/hosting

    Hosting provider switches.

    Example context (json):
    {"action": "", "sesskey": "x", "hidepromo": false, "useaiformat": true, "i": {} }
}}
<form class="ll-hs" method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <p class="ll-muted">{{#str}}hostingsettings_desc, theme_lmslabs{{/str}}</p>
    <div class="ll-panel">
        <div class="ll-panel-body ll-hs-list">
            <div class="ll-hs-row">
                <div><strong data-ll-tip="{{#str}}tip_hs_promo, theme_lmslabs{{/str}}">{{#str}}hidepromo, theme_lmslabs{{/str}}</strong>
                    <p class="ll-muted">{{#str}}hs_promo_help, theme_lmslabs{{/str}}</p></div>
                <label class="ll-toggle"><input type="hidden" name="hidepromo" value="0"><input type="checkbox" name="hidepromo" value="1"{{#hidepromo}} checked{{/hidepromo}} aria-label="{{#str}}hidepromo, theme_lmslabs{{/str}}"><span class="ll-switch-track"></span></label>
            </div>
            <div class="ll-hs-row">
                <div><strong data-ll-tip="{{#str}}tip_hs_ai, theme_lmslabs{{/str}}">{{#str}}useaiformat, theme_lmslabs{{/str}}</strong>
                    <p class="ll-muted">{{#str}}hs_ai_help, theme_lmslabs{{/str}}</p></div>
                <label class="ll-toggle"><input type="hidden" name="useaiformat" value="0"><input type="checkbox" name="useaiformat" value="1"{{#useaiformat}} checked{{/useaiformat}} aria-label="{{#str}}useaiformat, theme_lmslabs{{/str}}"><span class="ll-switch-track"></span></label>
            </div>
        </div>
    </div>
    <div class="ll-formactions">
        <button type="submit" class="btn btn-primary" data-ll-tip="{{#str}}tip_hs_save, theme_lmslabs{{/str}}">{{#str}}savechanges{{/str}}</button>
    </div>
    <p class="ll-classic"><a href="{{classicurl}}" data-ll-tip="{{#str}}gb_classic_tip, theme_lmslabs{{/str}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</form>
