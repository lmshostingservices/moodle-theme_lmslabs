    @template theme_lmslabs/profile

    Profile page.

    Example context (json):
    {"name": "Sam Lee", "facts": [], "courses": [], "badges": [], "actions": [], "i": {} }
}}
<div class="ll-pr">
    <section class="ll-pr-hero">
        <div class="ll-pr-cover"></div>
        <div class="ll-pr-main">
            <span class="ll-pr-avatar">{{{picture}}}{{#online}}<i class="ll-online"></i>{{/online}}</span>
            <div class="ll-pr-who">
                <h2>{{name}}</h2>
                {{#sub}}<p>{{sub}}</p>{{/sub}}
                <p class="ll-pr-meta">{{{i.clock}}}{{#online}}{{#str}}msg_online, theme_lmslabs{{/str}}{{/online}}{{^online}}{{lastaccess}}{{/online}}{{#since}} · {{since}}{{/since}}</p>
            </div>
            <div class="ll-pr-actions">
                {{#actions}}<a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}} ll-btn-icon" href="{{url}}">{{{icon}}}<span>{{label}}</span></a>{{/actions}}
            </div>
        </div>
    </section>

    <div class="ll-pr-grid">
        <div class="ll-pr-col">
            {{#description}}
            <section class="ll-pcard"><header><span class="ll-fcard-ico">{{{i.user}}}</span><div><h2>{{#str}}pr_about, theme_lmslabs{{/str}}</h2></div></header>
                <div class="ll-pr-desc">{{{description}}}</div>
                {{#interests.0}}<div class="ll-tags">{{#interests}}<span class="ll-tag">{{tag}}</span>{{/interests}}</div>{{/interests.0}}
            </section>
            {{/description}}
            {{#hasfacts}}
            <section class="ll-pcard">
                <ul class="ll-pr-facts">
                    {{#facts}}<li>{{{icon}}}<span><small>{{label}}</small>{{#href}}<a href="{{href}}">{{value}}</a>{{/href}}{{^href}}{{value}}{{/href}}</span></li>{{/facts}}
                </ul>
            </section>
            {{/hasfacts}}
            {{#hasbadges}}
            <section class="ll-pcard"><header><span class="ll-fcard-ico">{{{i.award}}}</span><div><h2>{{#isme}}{{#str}}mybadges, theme_lmslabs{{/str}}{{/isme}}{{^isme}}{{#str}}badges, badges{{/str}}{{/isme}}</h2></div></header>
                <div class="ll-pr-badges">{{#badges}}<a href="{{url}}" title="{{name}}"><img src="{{image}}" alt="{{name}}" loading="lazy"></a>{{/badges}}</div>
            </section>
            {{/hasbadges}}
        </div>
        <div class="ll-pr-col">
            <section class="ll-pcard">
                <header><span class="ll-fcard-ico">{{{i.book}}}</span><div><h2>{{#str}}courses{{/str}} <em class="ll-opt">{{coursecount}}</em></h2></div></header>
                {{#hascourses}}
                <ul class="ll-pr-courses">
                    {{#courses}}
                    <li>
                        <span class="ll-mc-thumb ll-tint-{{tint}}">{{#image}}<img src="{{image}}" alt="">{{/image}}</span>
                        <span class="ll-pr-ctext"><a href="{{url}}"><strong>{{{name}}}</strong></a><small>{{role}}</small>
                            {{#progress}}<span class="ll-ib-prog"><span class="ll-bar"><span class="ll-bar-fill" style="width: {{progress}}%"></span></span><b>{{progress}}%</b></span>{{/progress}}
                        </span>
                        {{#gradesurl}}<a class="ll-iconbtn" href="{{gradesurl}}" title="{{#str}}grades{{/str}}" aria-label="{{#str}}grades{{/str}}">{{{i.arrow}}}</a>{{/gradesurl}}
                    </li>
                    {{/courses}}
                </ul>
                {{/hascourses}}
                {{^hascourses}}<p class="ll-ib-none">{{#str}}msg_noshared, theme_lmslabs{{/str}}</p>{{/hascourses}}
            </section>
        </div>
    </div>
    <p class="ll-classic"><a href="{{classicurl}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</div>
