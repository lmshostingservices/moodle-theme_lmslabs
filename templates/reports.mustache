    @template theme_lmslabs/reports

    Course reports hub.

    Example context (json):
    {"days": [], "attention": [], "links": [], "i": {} }
}}
<div class="ll-rp">
    <div class="ll-rp-kpis">
        <div class="ll-rp-kpi">{{{i.users}}}<b>{{learners}}</b><span>{{#str}}rp_learners, theme_lmslabs{{/str}}</span></div>
        <div class="ll-rp-kpi" data-ll-tip-self data-ll-tip="{{#str}}rp_active_tip, theme_lmslabs{{/str}}">{{{i.activity}}}<b>{{active7}}</b><span>{{#str}}rp_active, theme_lmslabs, {{activepct}}{{/str}}</span></div>
        <div class="ll-rp-kpi">{{{i.chart}}}<b>{{#hasavg}}{{avg}}%{{/hasavg}}{{^hasavg}}–{{/hasavg}}</b><span>{{#str}}pt_avg, theme_lmslabs{{/str}}</span></div>
        <div class="ll-rp-kpi">{{{i.trophy}}}<b>{{completed}}</b><span>{{#str}}rp_completed, theme_lmslabs{{/str}}</span></div>
    </div>

    <div class="ll-rp-grid">
        <section class="ll-pcard">
            <header><div><h2>{{#str}}rp_activity, theme_lmslabs{{/str}}</h2><p>{{#str}}rp_activity_desc, theme_lmslabs{{/str}}</p></div></header>
            <div class="ll-rp-chart" role="img" aria-label="{{#str}}rp_activity, theme_lmslabs{{/str}}">
                {{#days}}<div class="ll-rp-col{{#today}} is-today{{/today}}" title="{{label}}: {{n}}"><span style="height: {{h}}%"><b>{{n}}</b></span><small>{{label}}</small></div>{{/days}}
            </div>
        </section>
        <section class="ll-pcard">
            <header><span class="ll-fcard-ico ll-amberico">{{{i.alert}}}</span><div><h2>{{#str}}rp_attention, theme_lmslabs{{/str}}</h2><p>{{#str}}rp_attention_desc, theme_lmslabs{{/str}}</p></div></header>
            {{#hasattention}}
            <ul class="ll-rp-people">
                {{#attention}}
                <li><span class="ll-avatar ll-tint-{{tint}}">{{initials}}</span><span class="ll-rp-who"><strong>{{name}}</strong><small>{{statuslabel}} · {{last}}</small></span><a class="ll-iconbtn" href="{{messageurl}}" title="{{#str}}message, message{{/str}}" aria-label="{{#str}}message, message{{/str}}: {{name}}">{{{i.msg}}}</a></li>
                {{/attention}}
            </ul>
            <a class="ll-gr-open" href="{{participantsurl}}">{{#str}}rp_seeall, theme_lmslabs{{/str}} {{{i.arrow}}}</a>
            {{/hasattention}}
            {{^hasattention}}<p class="ll-cal-allclear">{{#str}}rp_allgood, theme_lmslabs{{/str}}</p>{{/hasattention}}
        </section>
    </div>

    <h2 class="ll-mb-h">{{#str}}rp_more, theme_lmslabs{{/str}}</h2>
    <div class="ll-rp-links">
        {{#links}}<a class="ll-way" href="{{url}}"><span class="ll-way-ico">{{{icon}}}</span><strong>{{name}}</strong><span>{{desc}}</span></a>{{/links}}
    </div>
    <p class="ll-classic"><a href="{{classicurl}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</div>
