{{!
    @template theme_lmslabs/addon

    Explains an LMS Labs add-on that is not installed.

    Example context (json):
    {"icon": "", "name": "Training matrix", "desc": "See who is current.", "where": "It will appear in the Training menu once installed.",
     "url": "https://lms-labs.com", "quicklinks": true, "features": [{"icon": "", "name": "Export to CSV", "text": ""}]}
}}
<div class="ll-addon-page">
    <div class="ll-addon-hero">
        <div class="ll-notice-ico">{{{icon}}}</div>
        <div>
            <h2>{{name}}</h2>
            <p>{{desc}}</p>
            <ul class="ll-addon-list">
                {{#features}}
                <li>{{{icon}}}<span>{{name}}</span></li>
                {{/features}}
            </ul>
            <p class="ll-addon-where">{{where}} {{#quicklinks}}{{#str}}ad_quicklinks, theme_lmslabs{{/str}}{{/quicklinks}}</p>
            <div class="ll-notice-actions">
                <a class="btn btn-primary" href="{{url}}" target="_blank" rel="noopener">{{#str}}ad_get, theme_lmslabs{{/str}}</a>
            </div>
        </div>
    </div>
    <p class="ll-addon-hint">{{#str}}ad_hide, theme_lmslabs{{/str}}</p>
</div>
