{{!
    @template theme_lmslabs/beacon_missing

    Explains that Beacon Reports is not installed.

    Example context (json):
    {"url": "https://lms-labs.com", "support": "mailto:x@example.com", "features": [] }
}}
<div class="ll-notice-page">
    <div class="ll-notice-card">
        <div class="ll-notice-ico">{{{icon}}}</div>
        <h2>{{#str}}beacon_missing_title, theme_lmslabs{{/str}}</h2>
        <p>{{#str}}beacon_missing_body, theme_lmslabs{{/str}}</p>
        <div class="ll-notice-actions">
            <a class="btn btn-primary" href="{{url}}" target="_blank" rel="noopener">{{#str}}beacon_get, theme_lmslabs{{/str}}</a>
            <a class="btn btn-secondary" href="{{support}}">{{#str}}promo_support, theme_lmslabs{{/str}}</a>
        </div>
    </div>
    <div class="ll-feature-grid">
        {{#features}}
        <div class="ll-feature">
            <div class="ll-feature-ico">{{{icon}}}</div>
            <div>
                <h3>{{name}}</h3>
                <p>{{text}}</p>
            </div>
        </div>
        {{/features}}
    </div>
</div>
