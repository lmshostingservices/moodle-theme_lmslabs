    @template theme_lmslabs/notifications

    Notifications list.

    Example context (json):
    {"config": "{}", "i": {} }
}}
<div class="ll-notif" data-ll-notif>
    <script type="application/json" data-nt-config>{{{config}}}</script>
    <div class="ll-nt-bar">
        <div class="ll-ib-tabs" role="tablist">
            <button type="button" role="tab" class="is-on" data-nt-tab="all" aria-selected="true">{{#str}}all{{/str}}</button>
            <button type="button" role="tab" data-nt-tab="unread" aria-selected="false">{{#str}}msg_unread, theme_lmslabs{{/str}} <b data-nt="count"></b></button>
        </div>
        <span class="ll-fb-spacer"></span>
        <button type="button" class="ll-pill" data-nt="markall">{{{i.check}}}<span>{{#str}}nt_markall, theme_lmslabs{{/str}}</span></button>
        <a class="ll-pill" href="{{prefsurl}}" data-ll-tip-self data-ll-tip="{{#str}}nt_prefs_tip, theme_lmslabs{{/str}}">{{{i.settings}}}<span>{{#str}}nt_prefs, theme_lmslabs{{/str}}</span></a>
    </div>
    <div class="ll-nt-list" data-nt="list"><div class="ll-ib-loading"></div></div>
    <p class="ll-classic"><a href="{{classicurl}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</div>
