{{!
    @template theme_lmslabs/filterbar_sort

    Sort menu for a filtered list; submits with the filter bar form.

    Example context (json):
    {"sorts": [{"value": "name", "label": "Name", "selected": true}], "hassorts": true, "i": {} }
}}
{{#hassorts}}
<label class="ll-fb-sort">{{{i.sort}}}<span class="visually-hidden sr-only">{{#str}}sortby{{/str}}</span>
    <select name="sort" form="ll-fb-form" data-fb-instant aria-label="{{#str}}sortby{{/str}}">
        {{#sorts}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/sorts}}
    </select>
</label>
{{/hassorts}}
