{{!
    @template theme_lmslabs/courses_row

    One course in the program editor.

    Example context (json):
    {"id": 2, "fullname": "Course", "shortname": "C1", "days": 0, "hours": 0, "req0": true, "i": {} }
}}
<li class="ll-prow{{#hiddenoncourses}} is-hidden{{/hiddenoncourses}}" draggable="true" data-course="{{id}}">
    <span class="ll-grip" title="{{#str}}dragtomove, theme_lmslabs{{/str}}" aria-hidden="true">{{{i.grip}}}</span>
    <div class="ll-prow-name">
        <strong>{{fullname}}</strong>
        <span>{{shortname}}{{#coursehidden}} <em class="ll-tag">{{#str}}hiddenfromstudents{{/str}}</em>{{/coursehidden}}</span>
    </div>
    <div class="ll-prow-rules">
        <label class="ll-field">
            <span>{{#str}}opens, theme_lmslabs{{/str}}</span>
            <select data-f="req" class="form-select custom-select">
                <option value="0"{{#req0}} selected{{/req0}}>{{#str}}req_none, theme_lmslabs{{/str}}</option>
                <option value="1"{{#req1}} selected{{/req1}}>{{#str}}req_submitted, theme_lmslabs{{/str}}</option>
                <option value="2"{{#req2}} selected{{/req2}}>{{#str}}req_completed, theme_lmslabs{{/str}}</option>
            </select>
        </label>
        <label class="ll-field ll-field-delay">
            <span>{{#str}}delay, theme_lmslabs{{/str}}</span>
            <span class="ll-delay">
                <input type="number" min="0" max="3650" data-f="days" value="{{days}}" class="form-control" aria-label="{{#str}}days{{/str}}"><em>{{#str}}days_short, theme_lmslabs{{/str}}</em>
                <input type="number" min="0" max="23" data-f="hours" value="{{hours}}" class="form-control" aria-label="{{#str}}hours{{/str}}"><em>{{#str}}hours_short, theme_lmslabs{{/str}}</em>
            </span>
        </label>
    </div>
    <div class="ll-prow-actions">
        <button type="button" class="ll-iconbtn" data-act="toggle" aria-pressed="{{#hiddenoncourses}}true{{/hiddenoncourses}}{{^hiddenoncourses}}false{{/hiddenoncourses}}"
                title="{{#str}}showhide, theme_lmslabs{{/str}}" aria-label="{{#str}}showhide, theme_lmslabs{{/str}}">
            <span class="ll-when-shown">{{{i.eye}}}</span><span class="ll-when-hidden">{{{i.eyeoff}}}</span>
        </button>
        <button type="button" class="ll-iconbtn" data-act="up" aria-label="{{#str}}moveup{{/str}}">{{{i.up}}}</button>
        <button type="button" class="ll-iconbtn" data-act="down" aria-label="{{#str}}movedown{{/str}}">{{{i.down}}}</button>
        <button type="button" class="ll-iconbtn ll-danger" data-act="remove" aria-label="{{#str}}removecourse, theme_lmslabs{{/str}}" title="{{#str}}removecourse, theme_lmslabs{{/str}}">{{{i.x}}}</button>
    </div>
</li>
