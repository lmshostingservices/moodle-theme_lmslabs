}}{{!
    @template theme_lmslabs/restore

    Restore a backup: pick or drop a file, preview it, choose where it goes.

    Example context (json):
    {"files": [], "i": {}, "action": "#", "sesskey": "x"}
}}
<div class="ll-rt">
    {{^preview}}
    <div class="ll-rt-pick">
        {{#canupload}}
        <form method="post" action="{{action}}" enctype="multipart/form-data" class="ll-rt-drop" data-rt-drop>
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="file" name="mbz" accept=".mbz" data-rt-file>
            <span class="ll-rt-dropico">{{{i.upload}}}</span>
            <strong>{{#str}}rt_drop, theme_lmslabs{{/str}}</strong>
            <span>{{#str}}rt_drop_desc, theme_lmslabs, {{maxsize}}{{/str}}</span>
            <span class="ll-rt-busy" data-rt-busy hidden><span class="ll-spin"></span>{{#str}}rt_uploading, theme_lmslabs{{/str}}</span>
        </form>
        {{/canupload}}
        <section class="ll-fcard">
            <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.clock}}}</span><div><h2>{{#str}}rt_recent, theme_lmslabs{{/str}}</h2><p>{{#str}}rt_recent_desc, theme_lmslabs{{/str}}</p></div></header>
            <div class="ll-fcard-body ll-rt-files">
                {{#files}}<a class="ll-rt-file" href="{{url}}"><span class="ll-bk-fico">{{{i.restore}}}</span><span class="ll-bk-fmain"><strong>{{name}}</strong><span>{{when}} · {{size}}</span></span><span class="ll-pill">{{#str}}rt_use, theme_lmslabs{{/str}}</span></a>{{/files}}
                {{^files}}<div class="ll-bk-empty">{{#str}}rt_nofiles, theme_lmslabs{{/str}}</div>{{/files}}
            </div>
        </section>
    </div>
    {{/preview}}

    {{#preview}}
    <form method="post" action="{{action}}" class="ll-rt-go" data-rt-go>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="tmp" value="{{tmp}}">
        <section class="ll-rt-summary">
            <span class="ll-rt-sumico">{{{i.book}}}</span>
            <div class="ll-rt-summain">
                <h2>{{name}}</h2>
                <p>{{short}} · {{#str}}rt_madeon, theme_lmslabs, {{date}}{{/str}} · {{size}}</p>
                <div class="ll-rt-facts">
                    <span><b>{{sections}}</b> {{#str}}rt_sections, theme_lmslabs{{/str}}</span>
                    <span><b>{{activities}}</b> {{#str}}rt_activities, theme_lmslabs{{/str}}</span>
                    {{#mods}}<span class="ll-rt-mod">{{n}} {{name}}</span>{{/mods}}
                    {{#hasusers}}<span class="ll-rt-users">{{{i.users}}}{{#str}}rt_hasusers, theme_lmslabs{{/str}}</span>{{/hasusers}}
                </div>
            </div>
            <a class="ll-iconbtn" href="{{backurl}}" title="{{#str}}rt_other, theme_lmslabs{{/str}}" aria-label="{{#str}}rt_other, theme_lmslabs{{/str}}">{{{i.x}}}</a>
        </section>

        <section class="ll-fcard">
            <header class="ll-fcard-head"><span class="ll-fcard-ico">{{{i.restore}}}</span><div><h2>{{#str}}rt_where, theme_lmslabs{{/str}}</h2><p>{{#str}}rt_where_desc, theme_lmslabs{{/str}}</p></div></header>
            <div class="ll-fcard-body">
                <div class="ll-cp-rules ll-rt-where">
                    {{#cancreate}}<label class="ll-cp-rule"><input type="radio" name="where" value="new"{{^incourse}} checked{{/incourse}} data-rt-where><span class="ll-swcard-ico">{{{i.plus}}}</span><span class="ll-toggle-text"><strong>{{#str}}rt_new, theme_lmslabs{{/str}}</strong><span>{{#str}}rt_new_desc, theme_lmslabs{{/str}}</span></span></label>{{/cancreate}}
                    {{#incourse}}
                    <label class="ll-cp-rule"><input type="radio" name="where" value="add" checked data-rt-where><span class="ll-swcard-ico">{{{i.merge}}}</span><span class="ll-toggle-text"><strong>{{#str}}rt_add, theme_lmslabs{{/str}}</strong><span>{{#str}}rt_add_desc, theme_lmslabs, {{coursename}}{{/str}}</span></span></label>
                    <label class="ll-cp-rule ll-rt-danger"><input type="radio" name="where" value="replace" data-rt-where><span class="ll-swcard-ico">{{{i.replace}}}</span><span class="ll-toggle-text"><strong>{{#str}}rt_replace, theme_lmslabs{{/str}}</strong><span>{{#str}}rt_replace_desc, theme_lmslabs{{/str}}</span></span></label>
                    {{/incourse}}
                </div>
                {{#cancreate}}
                <label class="ll-f ll-f-narrow ll-rt-cat" data-rt-cat{{#incourse}} hidden{{/incourse}}><span data-ll-tip="{{#str}}rt_cat_tip, theme_lmslabs{{/str}}">{{#str}}category{{/str}}</span>
                    <select class="custom-select form-select" name="category">{{#categories}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{{name}}}</option>{{/categories}}</select></label>
                {{/cancreate}}
                {{#canusers}}
                <label class="ll-toggle ll-rt-userst"><input type="checkbox" name="users" value="1"><span class="ll-switch-track" aria-hidden="true"></span><span class="ll-toggle-text"><strong>{{#str}}rt_users, theme_lmslabs{{/str}}</strong><span>{{#str}}rt_users_desc, theme_lmslabs{{/str}}</span></span></label>
                {{/canusers}}
                {{#notcourse}}<div class="ll-fnotice is-warn">{{{i.alert}}}<span>{{#str}}rt_notcourse, theme_lmslabs{{/str}}</span></div>{{/notcourse}}
            </div>
        </section>
        <div class="ll-rt-bar">
            <span class="ll-rt-replacewarn" data-rt-warn hidden>{{{i.alert}}}{{#str}}rt_replace_warn, theme_lmslabs{{/str}}</span>
            <span class="ll-rt-busy" data-rt-busy hidden><span class="ll-spin"></span>{{#str}}rt_busy, theme_lmslabs{{/str}}</span>
            <button type="submit" class="btn btn-primary ll-btn-icon" data-rt-submit>{{{i.restore}}}<span>{{#str}}rt_go, theme_lmslabs{{/str}}</span></button>
        </div>
    </form>
    {{/preview}}
    <p class="ll-classic"><a href="{{classicurl}}">{{#str}}classicview, theme_lmslabs{{/str}}</a></p>
</div>
