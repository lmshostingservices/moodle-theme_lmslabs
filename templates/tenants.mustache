{{!
    @template theme_lmslabs/tenants

    Tenants and branding.

    Example context (json):
    {"tenants": [], "cohorts": [], "i": {}, "action": "#", "sesskey": "x"}
}}
<div class="ll-tn" data-ll-tn>
    <section class="ll-cb-head">
        <div><h2>{{#str}}tn_heading, theme_lmslabs{{/str}}</h2><p class="ll-muted">{{#str}}tn_intro, theme_lmslabs{{/str}}</p></div>
        <div class="ll-cb-headact"><button type="button" class="btn btn-primary ll-btn-icon" data-tn="new" data-ll-tip="{{#str}}tn_new_tip, theme_lmslabs{{/str}}">{{{i.plus}}}<span>{{#str}}tn_new, theme_lmslabs{{/str}}</span></button></div>
    </section>
    {{#hastenants}}
    <div class="ll-cb-grid">
        {{#tenants}}
        <article class="ll-cb-card ll-tn-card{{^enabled}} is-off{{/enabled}}" style="--tn:{{color}}">
            <div class="ll-cb-top">
                <span class="ll-tn-logo">{{#logo}}<img src="{{logo}}" alt="">{{/logo}}{{^logo}}<b>{{initial}}</b>{{/logo}}</span>
                <div class="ll-cb-title"><strong>{{name}}</strong><span class="ll-cb-state">{{#enabled}}{{#str}}tn_on, theme_lmslabs{{/str}}{{/enabled}}{{^enabled}}{{#str}}tn_off, theme_lmslabs{{/str}}{{/enabled}}</span></div>
                <span class="ll-tn-swatch" title="{{color}}"></span>
            </div>
            <div class="ll-cb-rule"><span class="ll-chip-tag">{{{i.users}}} {{cohort}} · {{members}}</span>{{#sitename}}<span class="ll-chip-tag">{{sitename}}</span>{{/sitename}}</div>
            <div class="ll-tn-link"><code>{{loginurl}}</code><button type="button" class="ll-iconbtn" data-tn="copy" data-url="{{loginurl}}" title="{{#str}}tn_copy, theme_lmslabs{{/str}}" aria-label="{{#str}}tn_copy, theme_lmslabs{{/str}}">{{{i.copy}}}</button></div>
            <div class="ll-cb-foot">
                <span class="ll-muted">{{#str}}tn_loginhint, theme_lmslabs{{/str}}</span>
                <span class="ll-cb-links">
                    <button type="button" class="ll-iconbtn" data-tn="edit" data-id="{{id}}" data-name="{{rawname}}" data-idnumber="{{idnumber}}" data-cohort="{{cohortid}}" data-color="{{#hascolor}}{{color}}{{/hascolor}}" data-sitename="{{sitename}}" data-enabled="{{#enabled}}1{{/enabled}}" data-haslogo="{{#logo}}1{{/logo}}" title="{{#str}}edit{{/str}}" aria-label="{{#str}}edit{{/str}}">{{{i.pencil}}}</button>
                    <form method="post" action="{{action}}" data-tn-del><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{id}}"><button type="submit" class="ll-iconbtn" title="{{#str}}delete{{/str}}" aria-label="{{#str}}delete{{/str}}" data-confirm="{{#str}}tn_confirmdelete, theme_lmslabs{{/str}}">{{{i.trash}}}</button></form>
                </span>
            </div>
        </article>
        {{/tenants}}
    </div>
    {{/hastenants}}
    {{^hastenants}}
    <div class="ll-empty ll-empty-flat"><div class="ll-empty-ico">{{{i.building}}}</div><h2>{{#str}}tn_none, theme_lmslabs{{/str}}</h2><p>{{#str}}tn_none_desc, theme_lmslabs{{/str}}</p>
        <button type="button" class="btn btn-primary ll-btn-icon" data-tn="new">{{{i.plus}}}<span>{{#str}}tn_new, theme_lmslabs{{/str}}</span></button></div>
    {{/hastenants}}

    <div class="ll-ib-modal" data-tn-modal hidden role="dialog" aria-modal="true" aria-label="{{#str}}tn_new, theme_lmslabs{{/str}}">
        <form class="ll-ib-modalcard" method="post" action="{{action}}" enctype="multipart/form-data" data-tn-form>
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="0">
            <header><h3 data-tn-title>{{#str}}tn_new, theme_lmslabs{{/str}}</h3><button type="button" class="ll-iconbtn" data-tn="close" aria-label="{{#str}}closebuttontitle{{/str}}">{{{i.x}}}</button></header>
            <label class="ll-f"><span data-ll-tip="{{#str}}tn_name_tip, theme_lmslabs{{/str}}">{{#str}}tn_name, theme_lmslabs{{/str}}</span><input class="form-control" name="name" maxlength="120" required></label>
            <label class="ll-f"><span data-ll-tip="{{#str}}tn_cohort_tip, theme_lmslabs{{/str}}">{{#str}}tn_cohort, theme_lmslabs{{/str}}</span>
                <select class="form-select custom-select" name="cohortid" required>
                    <option value="">{{#str}}tn_pickcohort, theme_lmslabs{{/str}}</option>
                    {{#cohorts}}<option value="{{id}}">{{name}}</option>{{/cohorts}}
                </select>
                <small class="ll-fhint">{{#str}}tn_cohort_hint, theme_lmslabs{{/str}} <a href="{{cohortsurl}}">{{#str}}tn_managecohorts, theme_lmslabs{{/str}}</a></small>
            </label>
            <div class="ll-ov-fields">
                <label class="ll-f"><span data-ll-tip="{{#str}}tn_color_tip, theme_lmslabs{{/str}}">{{#str}}tn_color, theme_lmslabs{{/str}}</span><input type="color" class="form-control form-control-color" name="color" value="{{accent}}" data-tn-color><small class="ll-fhint"><label><input type="checkbox" data-tn-usedefault checked> {{#str}}tn_defaultcolor, theme_lmslabs{{/str}}</label></small></label>
                <label class="ll-f"><span data-ll-tip="{{#str}}tn_sitename_tip, theme_lmslabs{{/str}}">{{#str}}tn_sitename, theme_lmslabs{{/str}}</span><input class="form-control" name="sitename" maxlength="120"></label>
                <label class="ll-f"><span data-ll-tip="{{#str}}tn_slug_tip, theme_lmslabs{{/str}}">{{#str}}tn_slug, theme_lmslabs{{/str}}</span><input class="form-control" name="idnumber" maxlength="60" pattern="[A-Za-z0-9_-]*" placeholder="{{#str}}tn_slug_ph, theme_lmslabs{{/str}}"></label>
                <label class="ll-f"><span data-ll-tip="{{#str}}tn_logo_tip, theme_lmslabs{{/str}}">{{#str}}tn_logo, theme_lmslabs{{/str}}</span><input type="file" class="form-control" name="logo" accept="image/*"><small class="ll-fhint" data-tn-removewrap hidden><label><input type="checkbox" name="removelogo" value="1"> {{#str}}tn_removelogo, theme_lmslabs{{/str}}</label></small></label>
            </div>
            <label class="ll-chipcheck"><input type="checkbox" name="enabled" value="1" checked><span data-ll-tip="{{#str}}tn_enabled_tip, theme_lmslabs{{/str}}">{{#str}}tn_enabled, theme_lmslabs{{/str}}</span></label>
            <div class="ll-ib-modalfoot"><button type="submit" class="btn btn-primary">{{#str}}savechanges{{/str}}</button></div>
        </form>
    </div>
</div>
