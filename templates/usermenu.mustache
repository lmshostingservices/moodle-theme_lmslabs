    @template theme_lmslabs/usermenu

    Avatar menu with sections.

    Example context (json):
    {"fullname": "Sam Lee", "email": "sam@example.com", "sections": [], "logouturl": "#"}
}}
<div class="ll-um" data-ll-um>
    <button type="button" class="ll-um-btn" aria-haspopup="true" aria-expanded="false" data-ll-um-toggle aria-label="{{fullname}}">
        <span class="ll-um-avatar">{{{avatar}}}</span>
        {{#unread}}<span class="ll-um-dot" aria-hidden="true"></span>{{/unread}}
    </button>
    <div class="ll-um-menu" role="menu" hidden data-ll-um-menu>
        <div class="ll-um-head">
            <span class="ll-um-avatar ll-um-avatar-lg">{{{avatar}}}</span>
            <span class="ll-um-who"><strong>{{fullname}}</strong><span>{{email}}</span></span>
        </div>
        {{#metadata}}<div class="ll-um-meta">{{{content}}}</div>{{/metadata}}
        {{#sections}}
        <div class="ll-um-section">
            <div class="ll-um-title">{{title}}</div>
            {{#items}}
            <a role="menuitem" class="ll-um-item{{#active}} is-active{{/active}}" href="{{url}}">{{{icon}}}<span>{{label}}</span>{{#badge}}<b class="ll-um-badge">{{badge}}</b>{{/badge}}</a>
            {{/items}}
        </div>
        {{/sections}}
        <a role="menuitem" class="ll-um-item ll-um-logout" href="{{logouturl}}">{{{logouticon}}}<span>{{#str}}logout{{/str}}</span></a>
    </div>
</div>
